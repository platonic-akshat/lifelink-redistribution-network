{
  "realm": "lifelink",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "roles": {
    "realm": [
      { "name": "PROVIDER" },
      { "name": "NGO" },
      { "name": "COORDINATOR" },
      { "name": "ADMIN" }
    ]
  },
  "clients": [
    {
      "clientId": "lifelink-web",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:5173/*", "http://localhost:4200/*"],
      "webOrigins": ["http://localhost:5173", "http://localhost:4200"],
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "id": "33333333-3333-3333-3333-333333333333",
      "username": "ngo1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "NGO",
      "credentials": [
        { "type": "password", "value": "ngo1", "temporary": false }
      ],
      "realmRoles": ["NGO"],
      "attributes": {
        "organization_id": ["22222222-2222-2222-2222-222222222222"]
      }
    },
    {
      "id": "55555555-5555-5555-5555-555555555555",
      "username": "coordinator1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Coordinator",
      "credentials": [
        { "type": "password", "value": "coordinator1", "temporary": false }
      ],
      "realmRoles": ["COORDINATOR"],
      "attributes": {
        "organization_id": ["22222222-2222-2222-2222-222222222222"]
      }
    },
    {
      "id": "66666666-6666-6666-6666-666666666666",
      "username": "admin1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Admin",
      "credentials": [
        { "type": "password", "value": "admin1", "temporary": false }
      ],
      "realmRoles": ["ADMIN"],
      "attributes": {
        "organization_id": ["22222222-2222-2222-2222-222222222222"]
      }
    },
    {
      "id": "44444444-4444-4444-4444-444444444444",
      "username": "provider1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Provider",
      "credentials": [
        { "type": "password", "value": "provider1", "temporary": false }
      ],
      "realmRoles": ["PROVIDER"],
      "attributes": {
        "organization_id": ["11111111-1111-1111-1111-111111111111"]
